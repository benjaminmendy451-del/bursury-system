# Copy these into your hosting provider's environment-variable settings.
# Do NOT commit a real .env file.
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Public address of the site (used for links in emails)
SITE_URL=https://yourdomain.com

# Email notifications. Leave EMAIL_BACKEND unset while testing: emails are
# printed in the terminal. For real emails use the SMTP backend below.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Bursary Committee <your.address@gmail.com>
# Emailed when a new application arrives (comma-separated, optional)
COMMITTEE_EMAILS=

# SMS via Africa's Talking (optional). AT_USERNAME=sandbox is free test mode.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Switch to PostgreSQL by setting these (leave unset to use SQLite)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
