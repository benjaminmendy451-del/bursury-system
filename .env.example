# HOW TO USE
#   LOCAL (your computer): create a file named exactly  .env  in the same folder
#   as manage.py and copy ONLY the "Notifications" section below into it.
#   Do NOT copy the "Production" section to your local .env.
#   Write values WITHOUT quotes, and put comments on their own lines.
#   .env is ignored by Git, so your passwords are never uploaded to GitHub.

# ---------------------------------------------------------------- Notifications
# Where links in emails point to (use your real domain once the site is online)
SITE_URL=http://127.0.0.1:8000

# Real email through Gmail. Remove these 5 lines to go back to terminal-only emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.address@gmail.com
# A 16-letter Gmail App password (NOT your normal password), typed without spaces
EMAIL_HOST_PASSWORD=abcdefghijklmnop
DEFAULT_FROM_EMAIL=Bursary Committee <your.address@gmail.com>

# People emailed when a new application arrives (comma-separated, optional)
COMMITTEE_EMAILS=

# SMS through Africa's Talking. AT_USERNAME=sandbox is free test mode.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ------------------------------------------------------------------ Production
# Only for the live website (set these in your hosting provider's settings).
# DJANGO_SECRET_KEY=generate-a-long-random-string
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
